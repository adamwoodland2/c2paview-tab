#include <windows.h>
#include "resource.h"

// TreeView styles (commctrl.h values), spelled out so the .rc has no dependency on it.
#define TVS_HASBUTTONS      0x0001
#define TVS_HASLINES        0x0002
#define TVS_LINESATROOT     0x0004
#define TVS_DISABLEDRAGDROP 0x0010
#define TVS_SHOWSELALWAYS   0x0020
#define TVS_INFOTIP         0x0800

// The official Content Credentials icon (C2PA trademark, used unaltered - see assets/ICON-SOURCE.md).
IDI_CR ICON "..\\assets\\cr.ico"

// Property page. Sizes are dialog units so the page scales with the system font / DPI.
IDD_PAGE DIALOGEX 0, 0, 227, 215
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Content Credentials"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_CR, IDC_CRICON, 7, 7, 21, 20, SS_ICON | SS_REALSIZECONTROL
    LTEXT           "", IDC_HEAD, 33, 8, 187, 20, SS_NOPREFIX | SS_EDITCONTROL
    LTEXT           "", IDC_TEXT, 7, 32, 213, 40, SS_NOPREFIX | SS_EDITCONTROL
    CONTROL         "", IDC_TREE, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | TVS_INFOTIP | TVS_DISABLEDRAGDROP, 7, 75, 213, 115
    PUSHBUTTON      "Copy &details", IDC_COPY_TEXT, 7, 195, 62, 14
    PUSHBUTTON      "Copy manifest &JSON", IDC_COPY_JSON, 73, 195, 84, 14
    RTEXT           "", IDC_FOOT, 160, 198, 60, 8, SS_NOPREFIX
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION C2PAVIEW_VERSION_NUM
 PRODUCTVERSION C2PAVIEW_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Adam Woodland"
            VALUE "FileDescription",  "C2PA View - Content Credentials property sheet for Explorer"
            VALUE "FileVersion",      C2PAVIEW_VERSION_STR
            VALUE "InternalName",     "c2paview"
            VALUE "LegalCopyright",   "MIT License. Content Credentials icon is a trademark of the C2PA."
            VALUE "OriginalFilename", "c2paview.dll"
            VALUE "ProductName",      "C2PA View for Windows Explorer"
            VALUE "ProductVersion",   C2PAVIEW_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
